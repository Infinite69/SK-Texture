    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { SERVICES_LIST } from \'../data/services\';\nimport { ServiceItem, Category } from \'../types\';\nimport { \n  Sparkles, Mountain, Box, Layers, Sun, Grid, Paintbrush, Wind, ShieldCheck, \n  Droplets, Flame, Palette, Home, Building2, Castle, Search, ArrowRight, X, Check \n} from \'lucide-react\';\n\ninterface ServicesProps {\n  onSelectService: (service: ServiceItem) => void;\n  onBookSiteVisit: () => void;\n}\n\nexport const Services: React.FC<ServicesProps> = ({ onSelectService, onBookSiteVisit }) => {\n  const [activeCategory, setActiveCategory] = useState<Category>(\'All\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedModalService, setSelectedModalService] = useState<ServiceItem | null>(null);\n\n  const renderIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Sparkles\': return <Sparkles className=\"w-6 h-6 text-amber-600\" />;\n      case \'Mountain\': return <Mountain className=\"w-6 h-6 text-stone-600\" />;\n      case \'Box\': return <Box className=\"w-6 h-6 text-stone-700\" />;\n      case \'Layers\': return <Layers className=\"w-6 h-6 text-stone-600\" />;\n      case \'Sun\': return <Sun className=\"w-6 h-6 text-amber-500\" />;\n      case \'Grid\': return <Grid className=\"w-6 h-6 text-amber-700\" />;\n      case \'Paintbrush\': return <Paintbrush className=\"w-6 h-6 text-stone-700\" />;\n      case \'Wind\': return <Wind className=\"w-6 h-6 text-sky-600\" />;\n      case \'ShieldCheck\': return <ShieldCheck className=\"w-6 h-6 text-emerald-600\" />;\n      case \'Droplets\': return <Droplets className=\"w-6 h-6 text-blue-600\" />;\n      case \'Flame\': return <Flame className=\"w-6 h-6 text-amber-600\" />;\n      case \'Palette\': return <Palette className=\"w-6 h-6 text-stone-600\" />;\n      case \'Home\': return <Home className=\"w-6 h-6 text-stone-700\" />;\n      case \'Building2\': return <Building2 className=\"w-6 h-6 text-neutral-700\" />;\n      case \'Castle\': return <Castle className=\"w-6 h-6 text-amber-700\" />;\n      default: return <Sparkles className=\"w-6 h-6 text-stone-600\" />;\n    }\n  };\n\n  const filteredServices = SERVICES_LIST.filter(service => {\n    const matchesCategory = activeCategory === \'All\' || service.category === activeCategory;\n    const matchesSearch = service.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n                          service.shortDesc.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesCategory && matchesSearch;\n  });\n\n  return (\n    <section id=\"services\" className=\"py-24 bg-white dark:bg-neutral-950 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Header Title */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-stone-200 dark:border-neutral-800 pb-8\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <span className=\"text-xs font-mono uppercase tracking-[0.25em] text-stone-500 dark:text-stone-400\">\n              Architectural Solutions\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100\">\n              Our Texture & Finish Services\n            </h2>\n            <p className=\"text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-light\">\n              From Italian marble plasters to heavy-duty granule elevations, waterproof shields, and heat-reflective cool wall coatings.\n            </p>\n          </div>\n\n          {/* Search Bar */}\n          <div className=\"relative w-full md:w-72\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search services...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-2.5 text-xs bg-stone-50 dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 rounded-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-stone-500 dark:focus:border-stone-400\"\n            />\n          </div>\n        </div>\n\n        {/* Category Tabs */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {([\'All\', \'Exterior\', \'Interior\', \'Protective\', \'Specialty\'] as Category[]).map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setActiveCategory(cat)}\n              className={`px-5 py-2 text-xs uppercase tracking-widest font-semibold transition-all rounded-sm ${\n                activeCategory === cat\n                  ? \'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 shadow-md\'\n                  : \'bg-stone-100 dark:bg-neutral-900 text-stone-600 dark:text-stone-400 hover:bg-stone-200 dark:hover:bg-neutral-800\'\n              }`}\n            >\n              {cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Services Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8\">\n          {filteredServices.map((service) => (\n            <div\n              key={service.id}\n              onClick={() => setSelectedModalService(service)}\n              className=\"group bg-stone-50/60 dark:bg-neutral-900/60 border border-stone-200/80 dark:border-neutral-800/80 rounded-sm overflow-hidden hover:border-stone-400 dark:hover:border-stone-600 transition-all duration-300 hover:shadow-xl flex flex-col justify-between cursor-pointer\"\n            >\n              <div className=\"space-y-4 p-6\">\n                {/* Image & Icon Header */}\n                <div className=\"relative h-48 w-full overflow-hidden rounded-sm mb-4\">\n                  <img\n                    src={service.image}\n                    alt={service.title}\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-95\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute top-3 right-3 p-2.5 bg-white/90 dark:bg-neutral-950/90 backdrop-blur-md rounded-sm shadow-md\">\n                    {renderIcon(service.iconName)}\n                  </div>\n                  <span className=\"absolute bottom-3 left-3 text-[10px] font-mono uppercase tracking-widest px-2.5 py-1 bg-stone-900/90 text-white backdrop-blur-md\">\n                    {service.category}\n                  </span>\n                </div>\n\n                <h3 className=\"font-serif text-xl font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-stone-600 dark:group-hover:text-stone-300 transition-colors\">\n                  {service.title}\n                </h3>\n\n                <p className=\"text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-light leading-relaxed\">\n                  {service.shortDesc}\n                </p>\n\n                {/* Features Pills */}\n                <div className=\"flex flex-wrap gap-1.5 pt-2\">\n                  {service.features.slice(0, 2).map((feat, i) => (\n                    <span key={i} className=\"text-[10px] px-2 py-0.5 bg-stone-200/70 dark:bg-neutral-800 text-stone-800 dark:text-stone-300 rounded-xs\">\n                      \342\200\242 {feat}\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Bottom Card Footer */}\n              <div className=\"p-6 pt-0 border-t border-stone-200/40 dark:border-neutral-800/40 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-stone-800 dark:text-stone-200 group-hover:text-amber-600 transition-colors\">\n                <span>View Technical Specs</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Service Detail Modal */}\n      {selectedModalService && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-950/80 backdrop-blur-md animate-in fade-in duration-200\">\n          <div className=\"bg-white dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 max-w-2xl w-full rounded-sm overflow-hidden shadow-2xl space-y-6 p-6 sm:p-8 max-h-[90vh] overflow-y-auto relative\">\n            <button\n              onClick={() => setSelectedModalService(null)}\n              className=\"absolute top-4 right-4 p-2 text-stone-500 hover:text-stone-900 dark:hover:text-white\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-3 bg-stone-100 dark:bg-neutral-800 rounded-sm\">\n                {renderIcon(selectedModalService.iconName)}\n              </div>\n              <div>\n                <span className=\"text-[10px] uppercase font-mono tracking-widest text-stone-500\">{selectedModalService.category} Service</span>\n                <h3 className=\"font-serif text-2xl font-bold text-neutral-900 dark:text-neutral-100\">\n                  {selectedModalService.title}\n                </h3>\n              </div>\n            </div>\n\n            <img\n              src={selectedModalService.image}\n              alt={selectedModalService.title}\n              className=\"w-full h-56 object-cover rounded-sm\"\n              referrerPolicy=\"no-referrer\"\n            />\n\n            <p className=\"text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed\">\n              {selectedModalService.longDesc}\n            </p>\n\n            <div className=\"space-y-2 pt-2\">\n              <h4 className=\"text-xs uppercase font-mono tracking-wider text-stone-500\">Key Features & Technical Advantages</h4>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                {selectedModalService.features.map((feat, i) => (\n                  <div key={i} className=\"flex items-center gap-2 text-xs text-neutral-800 dark:text-neutral-200 bg-stone-50 dark:bg-neutral-800/60 p-2 rounded-xs\">\n                    <Check className=\"w-3.5 h-3.5 text-amber-600 shrink-0\" />\n                    <span>{feat}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"pt-4 flex flex-col sm:flex-row gap-3\">\n              <button\n                onClick={() => {\n                  setSelectedModalService(null);\n                  onBookSiteVisit();\n                }}\n                className=\"w-full py-3 bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 text-xs uppercase font-bold tracking-wider hover:bg-stone-800 transition-colors\"\n              >\n                Request Free Site Visit for {selectedModalService.title}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};\n"
    }
