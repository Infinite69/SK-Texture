    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Calculator as CalcIcon, ShieldCheck, Sparkles, ArrowRight, CheckCircle2 } from \'lucide-react\';\n\ninterface CalculatorProps {\n  onBookSiteVisit: () => void;\n}\n\nexport const Calculator: React.FC<CalculatorProps> = ({ onBookSiteVisit }) => {\n  const [wallWidth, setWallWidth] = useState<number>(30);\n  const [wallHeight, setWallHeight] = useState<number>(10);\n  const [numberOfWalls, setNumberOfWalls] = useState<number>(4);\n  const [finishTier, setFinishTier] = useState<\'rustic\' | \'concrete\' | \'marble\' | \'granules\' | \'waterproof\'>(\'concrete\');\n  const [isExterior, setIsExterior] = useState<boolean>(true);\n\n  const rates = {\n    rustic: { name: \'Tuscan Rustic Stone\', rateSqFt: 65, desc: \'Deep granular stone texture\' },\n    concrete: { name: \'Board-Formed Fairface Concrete\', rateSqFt: 85, desc: \'Architectural raw beton microcement\' },\n    marble: { name: \'Italian Stucco Marble Polish\', rateSqFt: 125, desc: \'High-gloss Venetian plaster finish\' },\n    granules: { name: \'Natural Quartz Granules\', rateSqFt: 75, desc: \'Granite & quartz chip matrix\' },\n    waterproof: { name: \'Aquastop Elastomeric Shield\', rateSqFt: 55, desc: \'Hydrophobic anti-crack weather shield\' }\n  };\n\n  const totalAreaSqFt = Math.max(10, wallWidth * wallHeight * numberOfWalls);\n  const selectedRate = rates[finishTier];\n  const baseCost = totalAreaSqFt * selectedRate.rateSqFt;\n  const estimatedDays = Math.ceil(totalAreaSqFt / 1200);\n\n  return (\n    <section id=\"calculator\" className=\"py-24 bg-stone-50 dark:bg-neutral-900 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Title */}\n        <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n          <div className=\"inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-stone-600 dark:text-stone-400\">\n            <CalcIcon className=\"w-4 h-4 text-amber-600\" />\n            <span>Instant Estimator</span>\n          </div>\n          <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100\">\n            Wall Texture Area & Cost Calculator\n          </h2>\n          <p className=\"text-sm text-neutral-600 dark:text-neutral-400 font-light\">\n            Get an instant estimated surface area and material budget for your residential villa, apartment, or commercial tower project.\n          </p>\n        </div>\n\n        {/* Calculator Widget */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white dark:bg-neutral-950 border border-stone-200 dark:border-neutral-800 p-6 sm:p-10 rounded-sm shadow-xl\">\n          {/* Inputs Column */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            <h3 className=\"font-serif text-xl font-medium text-neutral-900 dark:text-neutral-100 border-b border-stone-200 dark:border-neutral-800 pb-3\">\n              1. Project Dimensions\n            </h3>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n              <div>\n                <label className=\"block text-xs font-mono uppercase tracking-wider text-stone-500 mb-1\">\n                  Wall Width (Ft)\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  value={wallWidth}\n                  onChange={(e) => setWallWidth(Math.max(1, Number(e.target.value)))}\n                  className=\"w-full p-3 text-sm font-mono bg-stone-50 dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 rounded-xs text-neutral-900 dark:text-neutral-100 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-mono uppercase tracking-wider text-stone-500 mb-1\">\n                  Wall Height (Ft)\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  value={wallHeight}\n                  onChange={(e) => setWallHeight(Math.max(1, Number(e.target.value)))}\n                  className=\"w-full p-3 text-sm font-mono bg-stone-50 dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 rounded-xs text-neutral-900 dark:text-neutral-100 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-mono uppercase tracking-wider text-stone-500 mb-1\">\n                  No. of Walls / Sides\n                </label>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  value={numberOfWalls}\n                  onChange={(e) => setNumberOfWalls(Math.max(1, Number(e.target.value)))}\n                  className=\"w-full p-3 text-sm font-mono bg-stone-50 dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 rounded-xs text-neutral-900 dark:text-neutral-100 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            {/* Finish Tier Selection */}\n            <div className=\"space-y-3 pt-2\">\n              <h3 className=\"font-serif text-xl font-medium text-neutral-900 dark:text-neutral-100 border-b border-stone-200 dark:border-neutral-800 pb-3\">\n                2. Select Texture Finish Class\n              </h3>\n\n              <div className=\"space-y-2\">\n                {(Object.keys(rates) as Array<keyof typeof rates>).map((key) => {\n                  const item = rates[key];\n                  return (\n                    <button\n                      key={key}\n                      onClick={() => setFinishTier(key)}\n                      className={`w-full p-3.5 rounded-xs border text-left flex items-center justify-between transition-all ${\n                        finishTier === key\n                          ? \'border-stone-900 bg-stone-100 dark:border-stone-100 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 font-semibold shadow-sm\'\n                          : \'border-stone-200 dark:border-neutral-800 text-stone-600 dark:text-stone-400 hover:bg-stone-50\'\n                      }`}\n                    >\n                      <div>\n                        <span className=\"block text-xs font-bold uppercase\">{item.name}</span>\n                        <span className=\"text-[11px] text-stone-500 font-light\">{item.desc}</span>\n                      </div>\n                      <span className=\"text-xs font-mono font-bold text-amber-700 dark:text-amber-400\">\n                        \342\202\271{item.rateSqFt} / sq.ft.\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n\n          {/* Instant Summary Output Column */}\n          <div className=\"lg:col-span-5 bg-stone-900 text-white p-6 sm:p-8 rounded-sm flex flex-col justify-between space-y-6\">\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center justify-between border-b border-neutral-800 pb-4\">\n                <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">Estimated Summary</span>\n                <span className=\"text-[10px] font-mono px-2 py-0.5 bg-amber-600 text-white font-bold\">10-Yr Guarantee</span>\n              </div>\n\n              <div className=\"space-y-4\">\n                <div>\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">Total Surface Area</span>\n                  <p className=\"font-serif text-3xl font-bold text-neutral-100\">\n                    {totalAreaSqFt.toLocaleString()} <span className=\"text-sm font-sans font-light text-neutral-400\">sq. ft.</span>\n                  </p>\n                </div>\n\n                <div>\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">Selected Material & Finish</span>\n                  <p className=\"text-sm font-semibold text-amber-400\">{selectedRate.name}</p>\n                </div>\n\n                <div>\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">Estimated Turnaround</span>\n                  <p className=\"text-sm font-medium text-neutral-200\">{estimatedDays} - {estimatedDays + 2} Application Days</p>\n                </div>\n\n                <div className=\"pt-4 border-t border-neutral-800\">\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">Approximate Budget Range</span>\n                  <p className=\"font-serif text-3xl sm:text-4xl font-bold text-neutral-100 mt-1\">\n                    \342\202\271{baseCost.toLocaleString()} <span className=\"text-xs text-neutral-400 font-sans font-normal\">*incl. materials & labor</span>\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"space-y-3 pt-4\">\n              <button\n                onClick={onBookSiteVisit}\n                className=\"w-full py-4 bg-stone-100 text-stone-950 hover:bg-white text-xs font-bold uppercase tracking-wider transition-all shadow-xl flex items-center justify-center gap-2\"\n              >\n                <span>Book Free On-Site Measurement</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n              <p className=\"text-[10px] text-center text-neutral-400\">\n                *Final quotation confirmed after on-site wall inspection & 1x1 ft sample approval in Gurugram / NCR.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
