  file_change {
    absolute_path_uri: "file:///src/components/Visualizer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TEXTURE_CATALOGUE } from \'../data/textures\';\nimport { TextureItem } from \'../types\';\nimport { Eye, Layers, Palette, RefreshCw, Sparkles, Check, Download, ArrowRight } from \'lucide-react\';\n\ninterface VisualizerProps {\n  onBookSiteVisitWithTexture: (texture: TextureItem) => void;\n}\n\nexport const Visualizer: React.FC<VisualizerProps> = ({ onBookSiteVisitWithTexture }) => {\n  const [selectedScene, setSelectedScene] = useState<\'villa\' | \'living\' | \'lobby\' | \'balcony\'>(\'villa\');\n  const [selectedTexture, setSelectedTexture] = useState<TextureItem>(TEXTURE_CATALOGUE[0]);\n  const [selectedColor, setSelectedColor] = useState(TEXTURE_CATALOGUE[0].recommendedColors[0]);\n\n  const scenes = [\n    {\n      id: \'villa\',\n      name: \'Luxury Villa Facade\',\n      bgImage: \'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1200&q=80\',\n      type: \'Exterior\'\n    },\n    {\n      id: \'living\',\n      name: \'Modern Living Room Feature Wall\',\n      bgImage: \'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1200&q=80\',\n      type: \'Interior\'\n    },\n    {\n      id: \'lobby\',\n      name: \'Corporate HQ Hotel Lobby\',\n      bgImage: \'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80\',\n      type: \'Commercial\'\n    },\n    {\n      id: \'balcony\',\n      name: \'Penthouse Balcony Elevation\',\n      bgImage: \'https://images.unsplash.com/photo-1590381105924-c72589b9ef3f?auto=format&fit=crop&w=1200&q=80\',\n      type: \'Exterior\'\n    }\n  ];\n\n  const currentScene = scenes.find(s => s.id === selectedScene) || scenes[0];\n\n  return (\n    <section id=\"visualizer\" className=\"py-24 bg-stone-900 text-white transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Header */}\n        <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n          <div className=\"inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.25em] text-amber-400\">\n            <Sparkles className=\"w-4 h-4\" />\n            <span>Interactive Wall Studio</span>\n          </div>\n          <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-100\">\n            Real-Time Architectural Texture Studio\n          </h2>\n          <p className=\"text-sm text-neutral-400 font-light\">\n            Visualize how SK Texture finishes look across luxury villa facades, living room feature walls, and commercial lobbies.\n          </p>\n        </div>\n\n        {/* Interactive Studio Workspace */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 bg-neutral-950 border border-neutral-800 rounded-sm overflow-hidden p-6 sm:p-8 shadow-2xl\">\n          {/* Left / Center Interactive Preview Canvas */}\n          <div className=\"lg:col-span-8 space-y-4\">\n            <div className=\"relative aspect-[16/10] w-full rounded-sm overflow-hidden border border-neutral-800 shadow-inner group\">\n              {/* Scene Image Base */}\n              <img\n                src={currentScene.bgImage}\n                alt={currentScene.name}\n                className=\"w-full h-full object-cover filter transition-all duration-700\"\n                referrerPolicy=\"no-referrer\"\n              />\n\n              {/* Texture Color Overlay Simulation */}\n              <div\n                className=\"absolute inset-0 mix-blend-multiply transition-all duration-700 pointer-events-none opacity-60\"\n                style={{ backgroundColor: selectedColor.hex }}\n              />\n\n              {/* Tactile Texture Grain Mask */}\n              <div\n                className=\"absolute inset-0 transition-all duration-700 pointer-events-none opacity-40 mix-blend-overlay\"\n                style={{\n                  backgroundImage: `url(${selectedTexture.image})`,\n                  backgroundSize: \'cover\',\n                  backgroundPosition: \'center\'\n                }}\n              />\n\n              {/* Scene Badge Overlay */}\n              <div className=\"absolute top-4 left-4 z-10 flex items-center gap-2\">\n                <span className=\"text-[10px] font-mono tracking-widest px-3 py-1 bg-neutral-900/90 text-white backdrop-blur-md rounded-xs\">\n                  {currentScene.name}\n                </span>\n                <span className=\"text-[10px] font-mono tracking-widest px-3 py-1 bg-amber-600/90 text-white backdrop-blur-md rounded-xs\">\n                  {selectedTexture.code} \342\200\242 {selectedColor.name}\n                </span>\n              </div>\n            </div>\n\n            {/* Scene Selector Bar */}\n            <div className=\"space-y-2\">\n              <span className=\"text-[10px] font-mono uppercase tracking-widest text-neutral-400\">Select Architectural Canvas:</span>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n                {scenes.map(s => (\n                  <button\n                    key={s.id}\n                    onClick={() => setSelectedScene(s.id as any)}\n                    className={`p-3 text-left rounded-sm border text-xs transition-all ${\n                      selectedScene === s.id\n                        ? \'border-amber-400 bg-neutral-900 text-white font-semibold\'\n                        : \'border-neutral-800 bg-neutral-900/40 text-neutral-400 hover:text-white\'\n                    }`}\n                  >\n                    <span className=\"block font-medium truncate\">{s.name}</span>\n                    <span className=\"text-[10px] text-neutral-500 uppercase\">{s.type}</span>\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Texture & Color Picker Controls */}\n          <div className=\"lg:col-span-4 space-y-6 flex flex-col justify-between\">\n            <div className=\"space-y-6\">\n              {/* Texture Picker */}\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">1. Select Finish</span>\n                  <span className=\"text-[10px] font-mono text-amber-400\">{selectedTexture.code}</span>\n                </div>\n\n                <div className=\"space-y-2 max-h-52 overflow-y-auto pr-1\">\n                  {TEXTURE_CATALOGUE.map(tex => (\n                    <button\n                      key={tex.id}\n                      onClick={() => {\n                        setSelectedTexture(tex);\n                        setSelectedColor(tex.recommendedColors[0]);\n                      }}\n                      className={`w-full p-2.5 rounded-sm border text-left flex items-center gap-3 transition-all ${\n                        selectedTexture.id === tex.id\n                          ? \'border-amber-400 bg-neutral-900 text-white font-semibold\'\n                          : \'border-neutral-800 bg-neutral-900/40 text-neutral-400 hover:bg-neutral-900\'\n                      }`}\n                    >\n                      <img src={tex.image} alt={tex.name} className=\"w-9 h-9 object-cover rounded-xs\" referrerPolicy=\"no-referrer\" />\n                      <div className=\"truncate\">\n                        <span className=\"block text-xs truncate\">{tex.name}</span>\n                        <span className=\"text-[10px] text-neutral-500 font-mono\">{tex.code} \342\200\242 {tex.thickness}</span>\n                      </div>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Color Swatch Picker */}\n              <div className=\"space-y-3\">\n                <span className=\"text-xs font-mono uppercase tracking-widest text-neutral-400\">2. Select Color Tone</span>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  {selectedTexture.recommendedColors.map((col, idx) => (\n                    <button\n                      key={idx}\n                      onClick={() => setSelectedColor(col)}\n                      className={`p-2 rounded-sm border text-xs flex items-center gap-2 transition-all ${\n                        selectedColor.name === col.name\n                          ? \'border-amber-400 bg-neutral-900 text-white font-semibold\'\n                          : \'border-neutral-800 bg-neutral-900/40 text-neutral-400\'\n                      }`}\n                    >\n                      <span className=\"w-4 h-4 rounded-full border border-neutral-700 shadow-xs\" style={{ backgroundColor: col.hex }} />\n                      <span className=\"truncate text-[11px]\">{col.name}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            {/* CTA Action */}\n            <div className=\"pt-4 space-y-2\">\n              <button\n                onClick={() => onBookSiteVisitWithTexture(selectedTexture)}\n                className=\"w-full py-3.5 bg-stone-100 text-stone-900 hover:bg-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xl flex items-center justify-center gap-2\"\n              >\n                <span>Order Physical Sample Box</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
