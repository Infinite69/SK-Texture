    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Award, ShieldCheck, Layers, Sparkles, CheckCircle2, Droplets, Sun, ChevronRight } from \'lucide-react\';\n\nexport const About: React.FC = () => {\n  const [activeLayer, setActiveLayer] = useState(2);\n\n  const applicationLayers = [\n    {\n      step: 1,\n      title: \'Deep Penetrating Anti-Damp Primer\',\n      desc: \'Formulated with nano-silicates that seal porous brick/concrete walls, neutralizes efflorescence alkalinity, and guarantees 100% adhesion.\',\n      thickness: \'0.2 mm\',\n      benefit: \'Prevents peeling & internal dampness\'\n    },\n    {\n      step: 2,\n      title: \'Polymers Elastomeric Base Coat\',\n      desc: \'Micro-fiber reinforced flexible coat capable of bridging hairline wall cracks up to 2mm while creating a smooth level bed.\',\n      thickness: \'1.0 mm\',\n      benefit: \'Cracks bridging & thermal buffer\'\n    },\n    {\n      step: 3,\n      title: \'Bespoke SK Mineral Texture Matrix\',\n      desc: \'Precision hand-troweled or spray-applied mineral matrix infused with graded quartz chips, slaked lime, or crushed natural stone.\',\n      thickness: \'1.5 - 3.5 mm\',\n      benefit: \'Authentic stone tactile finish\'\n    },\n    {\n      step: 4,\n      title: \'Aquastop Hydrophobic Nano Sealer\',\n      desc: \'Clear lotus-effect topcoat that repels rainwater, resists dust accumulation, and protects UV pigments from sun fading.\',\n      thickness: \'0.1 mm\',\n      benefit: \'Self-cleaning & 10-year weather shield\'\n    }\n  ];\n\n  return (\n    <section id=\"about\" className=\"py-24 bg-stone-50 dark:bg-neutral-900 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center\">\n          {/* Left Narrative Column */}\n          <div className=\"lg:col-span-6 space-y-6\">\n            <div className=\"inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] font-mono text-stone-600 dark:text-stone-400\">\n              <Award className=\"w-4 h-4 text-amber-600\" />\n              <span>15+ Years of Architectural Craftsmanship</span>\n            </div>\n\n            <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100 leading-tight\">\n              Crafting Timeless Wall Textures for Modern Architecture\n            </h2>\n\n            <p className=\"text-base sm:text-lg text-neutral-600 dark:text-neutral-300 font-light leading-relaxed\">\n              Based in Gurugram, <strong className=\"font-semibold text-neutral-900 dark:text-neutral-100\">SK Texture</strong> has spent over 15 years engineering exterior wall textures, decorative coatings, waterproofing shields, and luxury interior finishes that withstand India\342\200\231s extreme weather while exuding architectural luxury.\n            </p>\n\n            <p className=\"text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-light leading-relaxed\">\n              We collaborate directly with leading developers including <span className=\"font-medium text-neutral-800 dark:text-neutral-200\">DLF, M3M, IREO, Central Park</span>, top architectural firms, commercial building directors, schools, hospitals, and private villa owners to turn raw structures into visual landmarks.\n            </p>\n\n            <div className=\"grid grid-cols-2 gap-4 pt-4 border-t border-stone-200 dark:border-neutral-800\">\n              <div className=\"flex items-start gap-3\">\n                <CheckCircle2 className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-sm font-semibold text-neutral-900 dark:text-neutral-100\">100% Weather Hardy</h4>\n                  <p className=\"text-xs text-neutral-500 dark:text-neutral-400\">Resists 50\302\260C summer heat & heavy monsoon rain</p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <CheckCircle2 className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-sm font-semibold text-neutral-900 dark:text-neutral-100\">Master Applicators</h4>\n                  <p className=\"text-xs text-neutral-500 dark:text-neutral-400\">Trained artisans with decade-long experience</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Interactive Multi-Layer Coating Breakdown */}\n          <div className=\"lg:col-span-6 bg-white dark:bg-neutral-950 p-6 sm:p-8 rounded-sm border border-stone-200 dark:border-neutral-800 shadow-xl space-y-6\">\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs uppercase tracking-widest font-mono text-stone-500 dark:text-stone-400\">Application Engineering</span>\n                <span className=\"text-xs px-2.5 py-1 bg-stone-100 dark:bg-neutral-800 text-stone-800 dark:text-stone-200 font-mono\">4-Coat Protection System</span>\n              </div>\n              <h3 className=\"font-serif text-2xl font-light text-neutral-900 dark:text-neutral-100 mt-2\">\n                The Anatomy of SK Texture Wall Systems\n              </h3>\n            </div>\n\n            {/* Layer Selection Buttons */}\n            <div className=\"grid grid-cols-4 gap-2 border-b border-stone-200 dark:border-neutral-800 pb-2\">\n              {applicationLayers.map((layer, idx) => (\n                <button\n                  key={layer.step}\n                  onClick={() => setActiveLayer(idx)}\n                  className={`py-2 px-1 text-center text-xs font-semibold uppercase tracking-wider transition-all border-b-2 ${\n                    activeLayer === idx\n                      ? \'border-stone-900 dark:border-stone-100 text-stone-900 dark:text-stone-100\'\n                      : \'border-transparent text-stone-400 hover:text-stone-700 dark:hover:text-stone-300\'\n                  }`}\n                >\n                  Layer {layer.step}\n                </button>\n              ))}\n            </div>\n\n            {/* Active Layer Details */}\n            <div className=\"p-5 bg-stone-50 dark:bg-neutral-900/80 rounded-sm border border-stone-200/80 dark:border-neutral-800 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <h4 className=\"font-serif text-lg font-medium text-neutral-900 dark:text-neutral-100\">\n                  {applicationLayers[activeLayer].title}\n                </h4>\n                <span className=\"text-xs font-mono px-2 py-0.5 bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300\">\n                  {applicationLayers[activeLayer].thickness}\n                </span>\n              </div>\n\n              <p className=\"text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed font-sans\">\n                {applicationLayers[activeLayer].desc}\n              </p>\n\n              <div className=\"pt-2 flex items-center gap-2 text-xs font-semibold text-stone-800 dark:text-stone-200\">\n                <Sparkles className=\"w-3.5 h-3.5 text-amber-600\" />\n                <span>Primary Benefit: {applicationLayers[activeLayer].benefit}</span>\n              </div>\n            </div>\n\n            {/* Visual Stack Graphic */}\n            <div className=\"space-y-1.5 pt-2\">\n              {applicationLayers.map((layer, idx) => (\n                <div\n                  key={layer.step}\n                  onClick={() => setActiveLayer(idx)}\n                  className={`p-3 rounded-sm text-xs flex items-center justify-between cursor-pointer transition-all ${\n                    activeLayer === idx\n                      ? \'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 font-bold shadow-md scale-[1.01]\'\n                      : \'bg-stone-100 dark:bg-neutral-800 text-stone-600 dark:text-stone-400 hover:bg-stone-200 dark:hover:bg-neutral-750\'\n                  }`}\n                >\n                  <span>Coat {layer.step}: {layer.title}</span>\n                  <ChevronRight className=\"w-4 h-4 opacity-70\" />\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
