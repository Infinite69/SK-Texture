    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TEXTURE_CATALOGUE } from \'../data/textures\';\nimport { TextureItem } from \'../types\';\nimport { Search, ZoomIn, Check, Sparkles, Filter, X, ArrowRight, Shield, Layers, Sun } from \'lucide-react\';\n\ninterface TextureCatalogueProps {\n  onSelectTexture: (texture: TextureItem) => void;\n  onBookSiteVisitWithTexture: (texture: TextureItem) => void;\n}\n\nexport const TextureCatalogue: React.FC<TextureCatalogueProps> = ({\n  onSelectTexture,\n  onBookSiteVisitWithTexture\n}) => {\n  const [filterCategory, setFilterCategory] = useState<\'All\' | \'Interior\' | \'Exterior\' | \'Specialty\'>(\'All\');\n  const [search, setSearch] = useState(\'\');\n  const [selectedTexture, setSelectedTexture] = useState<TextureItem | null>(null);\n  const [activeColorIdx, setActiveColorIdx] = useState(0);\n\n  const filteredTextures = TEXTURE_CATALOGUE.filter(item => {\n    const matchesCat = filterCategory === \'All\' || item.category === filterCategory || item.interiorExterior === \'Both\';\n    const matchesSearch = item.name.toLowerCase().includes(search.toLowerCase()) ||\n                          item.code.toLowerCase().includes(search.toLowerCase()) ||\n                          item.description.toLowerCase().includes(search.toLowerCase());\n    return matchesCat && matchesSearch;\n  });\n\n  return (\n    <section id=\"catalogue\" className=\"py-24 bg-stone-100/70 dark:bg-neutral-900 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Apple Style Editorial Header */}\n        <div className=\"text-center space-y-4 max-w-3xl mx-auto\">\n          <span className=\"text-xs font-mono uppercase tracking-[0.3em] text-stone-500 dark:text-stone-400\">\n            Apple-Inspired Material Design\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-5xl md:text-6xl font-light text-neutral-900 dark:text-neutral-100 tracking-tight\">\n            The SK Wall Texture Catalogue.\n          </h2>\n          <p className=\"text-base sm:text-lg text-neutral-600 dark:text-neutral-300 font-light leading-relaxed\">\n            Tactile, durable, and acoustically refined. Explore our complete collection of architectural plaster, stone, and mineral finishes.\n          </p>\n        </div>\n\n        {/* Filter Controls Bar */}\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4 bg-white dark:bg-neutral-950 p-4 rounded-sm border border-stone-200 dark:border-neutral-800 shadow-sm\">\n          {/* Category Pills */}\n          <div className=\"flex flex-wrap items-center gap-2 w-full sm:w-auto\">\n            {([\'All\', \'Interior\', \'Exterior\', \'Specialty\'] as const).map(cat => (\n              <button\n                key={cat}\n                onClick={() => setFilterCategory(cat)}\n                className={`px-4 py-2 text-xs uppercase tracking-widest font-semibold transition-all rounded-xs ${\n                  filterCategory === cat\n                    ? \'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 shadow-sm\'\n                    : \'bg-stone-50 dark:bg-neutral-900 text-stone-600 dark:text-stone-400 hover:bg-stone-100\'\n                }`}\n              >\n                {cat}\n              </button>\n            ))}\n          </div>\n\n          {/* Search Field */}\n          <div className=\"relative w-full sm:w-72\">\n            <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-stone-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search code e.g. SK-MRB...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full pl-9 pr-4 py-2 text-xs bg-stone-50 dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 rounded-xs text-neutral-900 dark:text-neutral-100 focus:outline-none\"\n            />\n          </div>\n        </div>\n\n        {/* Masonry / Grid Display */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {filteredTextures.map(item => (\n            <div\n              key={item.id}\n              onClick={() => {\n                setSelectedTexture(item);\n                setActiveColorIdx(0);\n              }}\n              className=\"group relative bg-white dark:bg-neutral-950 border border-stone-200 dark:border-neutral-800 rounded-sm overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 cursor-pointer flex flex-col justify-between\"\n            >\n              {/* Image Container with Apple Style Zoom */}\n              <div className=\"relative aspect-[4/3] w-full overflow-hidden bg-stone-200 dark:bg-neutral-900\">\n                <img\n                  src={item.image}\n                  alt={item.name}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-95 group-hover:brightness-100\"\n                  referrerPolicy=\"no-referrer\"\n                />\n\n                {/* Top Badge Code */}\n                <div className=\"absolute top-4 left-4 flex items-center gap-2\">\n                  <span className=\"text-[10px] font-mono tracking-widest px-2.5 py-1 bg-neutral-900/90 text-white backdrop-blur-md rounded-xs\">\n                    {item.code}\n                  </span>\n                  {item.popular && (\n                    <span className=\"text-[10px] font-mono tracking-widest px-2.5 py-1 bg-amber-600/90 text-white backdrop-blur-md rounded-xs uppercase\">\n                      Popular\n                    </span>\n                  )}\n                </div>\n\n                {/* Hover Zoom Icon */}\n                <div className=\"absolute inset-0 bg-neutral-950/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center\">\n                  <div className=\"p-3 rounded-full bg-white/90 dark:bg-neutral-900/90 text-stone-900 dark:text-stone-100 shadow-xl transform scale-90 group-hover:scale-100 transition-transform\">\n                    <ZoomIn className=\"w-5 h-5\" />\n                  </div>\n                </div>\n              </div>\n\n              {/* Texture Details */}\n              <div className=\"p-6 space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-mono text-stone-500 uppercase tracking-widest\">\n                    {item.interiorExterior} \342\200\242 {item.thickness}\n                  </span>\n                  <span className=\"text-[10px] font-mono text-amber-700 dark:text-amber-400 uppercase\">\n                    {item.sheenLevel}\n                  </span>\n                </div>\n\n                <h3 className=\"font-serif text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-stone-600 dark:group-hover:text-stone-300 transition-colors\">\n                  {item.name}\n                </h3>\n\n                <p className=\"text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed font-light\">\n                  {item.description}\n                </p>\n\n                {/* Color Swatches Bar */}\n                <div className=\"pt-2 flex items-center gap-1.5\">\n                  <span className=\"text-[10px] font-mono text-stone-400 mr-1\">Shades:</span>\n                  {item.recommendedColors.map((col, idx) => (\n                    <span\n                      key={idx}\n                      className=\"w-3.5 h-3.5 rounded-full border border-stone-300 shadow-xs\"\n                      style={{ backgroundColor: col.hex }}\n                      title={col.name}\n                    />\n                  ))}\n                </div>\n              </div>\n\n              {/* Bottom CTA */}\n              <div className=\"p-4 bg-stone-50 dark:bg-neutral-900/60 border-t border-stone-200/60 dark:border-neutral-800/60 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-stone-800 dark:text-stone-200 group-hover:text-amber-600 transition-colors\">\n                <span>Explore Specification</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Full Screen Apple-Style Texture Modal */}\n      {selectedTexture && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-neutral-950/85 backdrop-blur-xl animate-in fade-in duration-300 overflow-y-auto\">\n          <div className=\"bg-white dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 max-w-4xl w-full rounded-sm overflow-hidden shadow-2xl relative my-auto\">\n            {/* Close Button */}\n            <button\n              onClick={() => setSelectedTexture(null)}\n              className=\"absolute top-4 right-4 z-20 p-2.5 rounded-full bg-neutral-900/80 text-white hover:bg-neutral-800 transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"grid grid-cols-1 lg:grid-cols-12\">\n              {/* Left Column: Texture Image & Color Swatch Selector */}\n              <div className=\"lg:col-span-6 bg-neutral-950 relative flex flex-col justify-between min-h-[320px] lg:min-h-[500px]\">\n                <img\n                  src={selectedTexture.image}\n                  alt={selectedTexture.name}\n                  className=\"w-full h-full object-cover absolute inset-0 filter brightness-95\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-neutral-950/90 via-transparent to-neutral-950/40\" />\n\n                <div className=\"relative z-10 p-6 flex justify-between items-start\">\n                  <span className=\"text-xs font-mono tracking-widest px-3 py-1 bg-neutral-900/90 text-white rounded-xs\">\n                    {selectedTexture.code}\n                  </span>\n                  <span className=\"text-xs font-mono tracking-widest px-3 py-1 bg-amber-600/90 text-white rounded-xs uppercase\">\n                    {selectedTexture.interiorExterior}\n                  </span>\n                </div>\n\n                <div className=\"relative z-10 p-6 space-y-2\">\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-stone-300\">Selected Color Variant</span>\n                  <div className=\"flex items-center gap-3\">\n                    <span\n                      className=\"w-6 h-6 rounded-full border-2 border-white shadow-md\"\n                      style={{ backgroundColor: selectedTexture.recommendedColors[activeColorIdx]?.hex || \'#fff\' }}\n                    />\n                    <span className=\"text-sm font-semibold text-white\">\n                      {selectedTexture.recommendedColors[activeColorIdx]?.name}\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Right Column: Full Specifications */}\n              <div className=\"lg:col-span-6 p-6 sm:p-8 space-y-6 max-h-[80vh] overflow-y-auto\">\n                <div>\n                  <span className=\"text-xs font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400\">\n                    {selectedTexture.category} Collection\n                  </span>\n                  <h3 className=\"font-serif text-3xl font-light text-neutral-900 dark:text-neutral-100 mt-1\">\n                    {selectedTexture.name}\n                  </h3>\n                  <p className=\"text-xs font-mono text-stone-500 mt-1\">\n                    Code: {selectedTexture.code} \342\200\242 Thickness: {selectedTexture.thickness}\n                  </p>\n                </div>\n\n                <p className=\"text-sm text-neutral-700 dark:text-neutral-300 font-light leading-relaxed\">\n                  {selectedTexture.description}\n                </p>\n\n                {/* Technical Metric Grid */}\n                <div className=\"grid grid-cols-2 gap-3 p-4 bg-stone-50 dark:bg-neutral-800/60 rounded-sm border border-stone-200 dark:border-neutral-700/60\">\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase text-stone-400\">Tactile Feel</span>\n                    <p className=\"text-xs font-semibold text-neutral-800 dark:text-neutral-200\">{selectedTexture.tactileFeel}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase text-stone-400\">Sheen Rating</span>\n                    <p className=\"text-xs font-semibold text-neutral-800 dark:text-neutral-200\">{selectedTexture.sheenLevel}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase text-stone-400\">Suitable Environment</span>\n                    <p className=\"text-xs font-semibold text-neutral-800 dark:text-neutral-200\">{selectedTexture.interiorExterior}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase text-stone-400\">Layer Thickness</span>\n                    <p className=\"text-xs font-semibold text-neutral-800 dark:text-neutral-200\">{selectedTexture.thickness}</p>\n                  </div>\n                </div>\n\n                {/* Color Swatch Picker */}\n                <div className=\"space-y-2\">\n                  <h4 className=\"text-xs font-mono uppercase tracking-wider text-stone-500\">Recommended Architect Swatches</h4>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {selectedTexture.recommendedColors.map((col, idx) => (\n                      <button\n                        key={idx}\n                        onClick={() => setActiveColorIdx(idx)}\n                        className={`flex items-center gap-2 px-3 py-1.5 rounded-sm border text-xs font-medium transition-all ${\n                          activeColorIdx === idx\n                            ? \'border-stone-900 bg-stone-100 dark:border-white dark:bg-neutral-800 text-stone-900 dark:text-white font-bold\'\n                            : \'border-stone-200 dark:border-neutral-700 text-stone-600 dark:text-stone-400\'\n                        }`}\n                      >\n                        <span className=\"w-3.5 h-3.5 rounded-full border border-stone-300\" style={{ backgroundColor: col.hex }} />\n                        <span>{col.name}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Best Applications */}\n                <div className=\"space-y-2\">\n                  <h4 className=\"text-xs font-mono uppercase tracking-wider text-stone-500\">Ideal Applications</h4>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {selectedTexture.bestApplications.map((app, idx) => (\n                      <span key={idx} className=\"text-xs px-2.5 py-1 bg-stone-100 dark:bg-neutral-800 text-stone-800 dark:text-stone-200 rounded-xs\">\n                        \342\200\242 {app}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Maintenance */}\n                <div className=\"p-3 bg-amber-50/60 dark:bg-amber-950/30 border border-amber-200/60 dark:border-amber-800/40 rounded-sm\">\n                  <span className=\"text-[10px] font-mono uppercase tracking-wider text-amber-800 dark:text-amber-400 font-bold\">Maintenance & Care:</span>\n                  <p className=\"text-xs text-stone-700 dark:text-stone-300 mt-0.5\">{selectedTexture.maintenance}</p>\n                </div>\n\n                {/* Action Buttons */}\n                <div className=\"pt-2 flex flex-col sm:flex-row gap-3\">\n                  <button\n                    onClick={() => {\n                      onBookSiteVisitWithTexture(selectedTexture);\n                      setSelectedTexture(null);\n                    }}\n                    className=\"flex-1 py-3.5 bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 text-xs uppercase font-bold tracking-wider hover:bg-stone-800 transition-colors shadow-lg\"\n                  >\n                    Request Physical Sample Box ({selectedTexture.code})\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};\n"
    }
