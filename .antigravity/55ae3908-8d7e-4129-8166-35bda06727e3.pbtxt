    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowRight, Calendar, Sparkles, Building2, ShieldCheck, MapPin, Award, CheckCircle2, Play, Pause } from \'lucide-react\';\n\ninterface HeroProps {\n  onOpenSiteVisit: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onOpenSiteVisit }) => {\n  const [isPlaying, setIsPlaying] = useState(true);\n\n  return (\n    <section className=\"relative min-h-screen flex flex-col justify-between pt-28 pb-12 overflow-hidden bg-neutral-950 text-white\">\n      {/* Background Architectural Video / Image Canvas */}\n      <div className=\"absolute inset-0 z-0\">\n        <img\n          src=\"https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=2000&q=90\"\n          alt=\"Luxury Architecture Villa Facade SK Texture\"\n          className=\"w-full h-full object-cover object-center scale-105 filter brightness-75 contrast-110 animate-pulse duration-[10000ms]\"\n          referrerPolicy=\"no-referrer\"\n        />\n        {/* Dark Luxury Gradient Overlays */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/60 to-neutral-950/40\" />\n        <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-transparent via-neutral-950/40 to-neutral-950/90\" />\n      </div>\n\n      {/* Hero Content Area */}\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-auto pt-12 sm:pt-20\">\n        <div className=\"max-w-4xl space-y-6 sm:space-y-8\">\n          {/* Eyebrow Label */}\n          <div className=\"inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-stone-400/30 bg-neutral-900/60 backdrop-blur-md text-stone-200 text-xs tracking-[0.2em] uppercase font-mono\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n            <span>Gurugram \342\200\242 Delhi NCR \342\200\242 Pan India</span>\n          </div>\n\n          {/* Main Title */}\n          <h1 className=\"font-serif text-4xl sm:text-6xl md:text-7xl font-light tracking-tight text-neutral-100 leading-[1.08]\">\n            Transform Ordinary Walls into{\' \'}\n            <span className=\"italic font-normal text-stone-300 underline decoration-stone-500/40 underline-offset-8\">\n              Architectural Masterpieces.\n            </span>\n          </h1>\n\n          {/* Subheading */}\n          <p className=\"text-lg sm:text-2xl text-neutral-300 font-light max-w-2xl leading-relaxed font-sans\">\n            Premium Exterior & Interior Texture Solutions. Built for Luxury Villas, High-Rise Towers, Commercial Plazas & Modern Estates.\n          </p>\n\n          {/* Call to Action Buttons */}\n          <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4\">\n            <button\n              onClick={onOpenSiteVisit}\n              className=\"px-8 py-4 bg-stone-100 text-stone-950 hover:bg-white text-xs uppercase tracking-[0.2em] font-bold shadow-xl hover:shadow-2xl hover:-translate-y-0.5 transition-all flex items-center justify-center gap-3 group cursor-pointer\"\n            >\n              <Calendar className=\"w-4 h-4 text-amber-600 group-hover:scale-110 transition-transform\" />\n              <span>Get Free Site Visit</span>\n              <ArrowRight className=\"w-4 h-4 text-stone-600 group-hover:translate-x-1 transition-transform\" />\n            </button>\n\n            <a\n              href=\"#catalogue\"\n              className=\"px-8 py-4 bg-neutral-900/80 hover:bg-neutral-800 text-neutral-100 border border-neutral-700/80 text-xs uppercase tracking-[0.2em] font-medium backdrop-blur-md transition-all flex items-center justify-center gap-3 text-center\"\n            >\n              <span>Explore Catalogue</span>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      {/* Trust Metrics Bar below Hero */}\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-12 sm:mt-16\">\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-8 border-t border-neutral-800/80 bg-neutral-950/60 backdrop-blur-xl p-6 sm:p-8 rounded-sm\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-baseline gap-1\">\n              <span className=\"font-serif text-3xl sm:text-4xl font-bold text-neutral-100\">15+</span>\n              <span className=\"text-stone-400 font-light text-sm\">Years</span>\n            </div>\n            <p className=\"text-xs uppercase tracking-widest text-neutral-400 font-medium\">Experience in Textures</p>\n          </div>\n\n          <div className=\"space-y-1\">\n            <div className=\"flex items-baseline gap-1\">\n              <span className=\"font-serif text-3xl sm:text-4xl font-bold text-neutral-100\">500+</span>\n              <span className=\"text-stone-400 font-light text-sm\">Projects</span>\n            </div>\n            <p className=\"text-xs uppercase tracking-widest text-neutral-400 font-medium\">Completed Nationwide</p>\n          </div>\n\n          <div className=\"space-y-1\">\n            <div className=\"flex items-baseline gap-1\">\n              <span className=\"font-serif text-3xl sm:text-4xl font-bold text-neutral-100\">100+</span>\n              <span className=\"text-stone-400 font-light text-sm\">Builders</span>\n            </div>\n            <p className=\"text-xs uppercase tracking-widest text-neutral-400 font-medium\">Trusted Builder Clients</p>\n          </div>\n\n          <div className=\"space-y-1\">\n            <div className=\"flex items-baseline gap-1\">\n              <span className=\"font-serif text-3xl sm:text-4xl font-bold text-stone-300\">All India</span>\n            </div>\n            <p className=\"text-xs uppercase tracking-widest text-neutral-400 font-medium\">On-Site Application Service</p>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
