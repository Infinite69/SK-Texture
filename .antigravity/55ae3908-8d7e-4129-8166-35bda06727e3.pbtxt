    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { TESTIMONIALS_LIST } from \'../data/testimonials\';\nimport { Star, Quote, Building2, Award } from \'lucide-react\';\n\nexport const Testimonials: React.FC = () => {\n  return (\n    <section className=\"py-24 bg-stone-100/70 dark:bg-neutral-900 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Title */}\n        <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n          <span className=\"text-xs font-mono uppercase tracking-[0.25em] text-stone-500 dark:text-stone-400\">\n            Endorsements of Quality\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100\">\n            Trusted by Builders & Architects\n          </h2>\n          <p className=\"text-sm text-neutral-600 dark:text-neutral-400 font-light\">\n            Read verified testimonials from luxury villa owners, principal architects, and project leaders across NCR.\n          </p>\n        </div>\n\n        {/* Testimonials Cards Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {TESTIMONIALS_LIST.map((item) => (\n            <div\n              key={item.id}\n              className=\"bg-white dark:bg-neutral-950 p-8 rounded-sm border border-stone-200 dark:border-neutral-800 shadow-md flex flex-col justify-between space-y-6 relative\"\n            >\n              <Quote className=\"w-10 h-10 text-stone-200 dark:text-neutral-800 absolute top-6 right-6\" />\n\n              <div className=\"space-y-4\">\n                {/* 5 Star Rating */}\n                <div className=\"flex items-center gap-1 text-amber-500\">\n                  {[...Array(item.rating)].map((_, i) => (\n                    <Star key={i} className=\"w-4 h-4 fill-amber-500\" />\n                  ))}\n                </div>\n\n                <p className=\"text-sm sm:text-base text-neutral-700 dark:text-neutral-300 font-light italic leading-relaxed\">\n                  \"{item.quote}\"\n                </p>\n              </div>\n\n              {/* Author Footer */}\n              <div className=\"flex items-center gap-4 pt-4 border-t border-stone-100 dark:border-neutral-800\">\n                <img\n                  src={item.image}\n                  alt={item.name}\n                  className=\"w-12 h-12 rounded-full object-cover border border-stone-300 dark:border-neutral-700\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div>\n                  <h4 className=\"font-serif text-base font-bold text-neutral-900 dark:text-neutral-100\">\n                    {item.name}\n                  </h4>\n                  <p className=\"text-xs text-stone-500 font-mono\">{item.role}</p>\n                  <span className=\"text-[10px] font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wider block\">\n                    {item.companyOrLocation}\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
