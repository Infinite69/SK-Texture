    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { FAQItem } from \'../types\';\n\nexport const FAQS_LIST: FAQItem[] = [\n  {\n    id: \'faq-1\',\n    question: \'How long does SK Texture exterior wall coating last?\',\n    answer: \'Our premium exterior textures (such as Granules, Rustic, Travertine, and Board-Formed Concrete) are engineered with high-grade acrylic resins and mineral pigments that last 10 to 15+ years without peeling, chalking, or fading. All projects come with a written warranty.\',\n    category: \'Durability\'\n  },\n  {\n    id: \'faq-2\',\n    question: \'Are SK Texture finishes 100% waterproof and rain-resistant?\',\n    answer: \'Yes! Our Aquastop Hydrophobic and Elastomeric coatings incorporate silane-siloxane nanotechnology. They form a breathable water barrier that repels monsoon downpours while allowing trapped wall moisture to evaporate out.\',\n    category: \'Waterproofing\'\n  },\n  {\n    id: \'faq-3\',\n    question: \'Can texture coatings reduce interior wall temperature?\',\n    answer: \'Yes. Our ThermaGuard Heat Reflective Cool Wall coating uses hollow ceramic microspheres that reflect up to 88% of solar infrared heat rays, lowering exterior wall temperatures by 4\302\260C to 7\302\260C and reducing indoor air conditioning bills.\',\n    category: \'Waterproofing\'\n  },\n  {\n    id: \'faq-4\',\n    question: \'Do you provide services outside Gurugram and Delhi NCR?\',\n    answer: \'Yes, SK Texture provides Pan-India execution services. While our headquarters are in Gurugram, our specialized master applicator teams travel across India for large luxury villas, commercial towers, hotels, and builder townships.\',\n    category: \'Service & Pricing\'\n  },\n  {\n    id: \'faq-5\',\n    question: \'Do you provide on-site texture sample mockups before starting?\',\n    answer: \'Absolutely. Following initial consultation, our team visits your site to apply 1x1 ft real physical texture samples on your wall so architects and owners can inspect color, sheen, and tactile feel in natural daylight.\',\n    category: \'Service & Pricing\'\n  },\n  {\n    id: \'faq-6\',\n    question: \'Which wall textures are recommended for high-end luxury villas?\',\n    answer: \'For luxury villa elevations, we highly recommend Roman Travertine Stone (SK-TRV-09), Board-Formed Raw Concrete (SK-CNC-02), and Tuscan Rustic Grain (SK-RST-04). For interiors, Carrara Stucco Polish (SK-MRB-01) and Satin Pearl Parlina (SK-PRL-03) create striking accent walls.\',\n    category: \'General\'\n  },\n  {\n    id: \'faq-7\',\n    question: \'How are SK Texture walls cleaned and maintained?\',\n    answer: \'Exterior textured walls can be easily cleaned using a standard water hose or high-pressure water jet wash once or twice a year. Interior polished textures can be wiped clean using a damp soft microfiber cloth.\',\n    category: \'Durability\'\n  },\n  {\n    id: \'faq-8\',\n    question: \'Can SK Texture be applied over existing painted or brick walls?\',\n    answer: \'Yes. Our team conducts thorough surface preparation, including washing away loose debris, filling cracks, and applying our deep-penetrating bonding primer. This allows new textures to adhere directly and permanently over existing plaster or paint.\',\n    category: \'General\'\n  }\n];\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { FAQItem } from \'../types\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const FAQS_LIST: FAQItem[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
