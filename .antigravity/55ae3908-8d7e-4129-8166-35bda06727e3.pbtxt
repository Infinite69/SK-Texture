      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Award, Sun, Droplets, Sparkles, Flame, CheckCircle2, Building2 } from \'lucide-react\';\n\nexport const WhyChooseUs: React.FC = () => {\n  const pillars = [\n    {\n      icon: <Award className=\"w-6 h-6 text-amber-600\" />,\n      title: \'15+ Years Mastery\',\n      desc: \'Deep engineering experience in exterior wall textures, decorative coatings, and weatherproofing across Pan-India.\'\n    },\n    {\n      icon: <Sparkles className=\"w-6 h-6 text-amber-600\" />,\n      title: \'Premium Imported Raw Materials\',\n      desc: \'Formulated with high-purity slaked lime, pure acrylic resins, natural quartz chips, and non-fading mineral pigments.\'\n    },\n    {\n      icon: <ShieldCheck className=\"w-6 h-6 text-amber-600\" />,\n      title: \'Expert Master Applicators\',\n      desc: \'Trained, safety-certified master artisans with decade-long experience in trowel burnishing and pneumatic spray precision.\'\n    },\n    {\n      icon: <Sun className=\"w-6 h-6 text-amber-600\" />,\n      title: \'Weather Resistant & Non-Chalking\',\n      desc: \'Tested against 50\302\260C scorching Indian summer UV exposure without cracking, fading, or peeling.\'\n    },\n    {\n      icon: <Droplets className=\"w-6 h-6 text-amber-600\" />,\n      title: \'Hydrophobic Waterproofing\',\n      desc: \'Nanotechnology silane-siloxane sealers that repel monsoon water while letting internal wall vapor vent out.\'\n    },\n    {\n      icon: <Flame className=\"w-6 h-6 text-amber-600\" />,\n      title: \'Heat Reflective Cool Wall\',\n      desc: \'Hollow ceramic microspheres that reflect up to 88% solar infrared heat rays, lowering wall temps by up to 7\302\260C.\'\n    }\n  ];\n\n  return (\n    <section className=\"py-24 bg-white dark:bg-neutral-950 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16\">\n        {/* Title */}\n        <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n          <span className=\"text-xs font-mono uppercase tracking-[0.25em] text-stone-500 dark:text-stone-400\">\n            Uncompromising Standards\n          </span>\n          <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100\">\n            Why Architects & Builders Choose SK Texture\n          </h2>\n          <p className=\"text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-light\">\n            Built for extreme durability, architectural sophistication, and hassle-free maintenance.\n          </p>\n        </div>\n\n        {/* Pillars Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {pillars.map((p, idx) => (\n            <div\n              key={idx}\n              className=\"p-8 bg-stone-50/70 dark:bg-neutral-900/60 border border-stone-200 dark:border-neutral-800 rounded-sm hover:border-amber-600/60 transition-all duration-300 hover:shadow-xl space-y-4\"\n            >\n              <div className=\"p-3 bg-white dark:bg-neutral-800 w-fit rounded-sm shadow-xs border border-stone-200 dark:border-neutral-700\">\n                {p.icon}\n              </div>\n              <h3 className=\"font-serif text-xl font-bold text-neutral-900 dark:text-neutral-100\">\n                {p.title}\n              </h3>\n              <p className=\"text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-light leading-relaxed\">\n                {p.desc}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
