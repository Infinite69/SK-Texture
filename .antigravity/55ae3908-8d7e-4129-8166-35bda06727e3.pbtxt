  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Phone, Calendar, Menu, X, Sun, Moon, Sparkles, MessageSquare } from \'lucide-react\';\n\ninterface NavbarProps {\n  darkMode: boolean;\n  setDarkMode: (val: boolean) => void;\n  onOpenSiteVisit: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ darkMode, setDarkMode, onOpenSiteVisit }) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrolled(window.scrollY > 40);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'About\', href: \'#about\' },\n    { name: \'Services\', href: \'#services\' },\n    { name: \'Catalogue\', href: \'#catalogue\' },\n    { name: \'Projects\', href: \'#projects\' },\n    { name: \'Wall Studio\', href: \'#visualizer\' },\n    { name: \'Cost Calculator\', href: \'#calculator\' },\n    { name: \'Process\', href: \'#process\' },\n    { name: \'Contact\', href: \'#contact\' },\n  ];\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ${\n        scrolled\n          ? darkMode\n            ? \'bg-neutral-950/85 backdrop-blur-md border-b border-neutral-800 shadow-2xl py-3.5\'\n            : \'bg-white/85 backdrop-blur-md border-b border-neutral-200/80 shadow-lg py-3.5\'\n          : \'bg-transparent py-5\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between\">\n          {/* Brand Logo */}\n          <a href=\"#\" className=\"flex items-center gap-3 group\">\n            <div className=\"w-10 h-10 rounded-sm bg-stone-900 dark:bg-stone-100 flex items-center justify-center text-stone-100 dark:text-stone-900 font-serif font-bold text-xl tracking-tighter shadow-md group-hover:scale-105 transition-transform\">\n              SK\n            </div>\n            <div className=\"flex flex-col\">\n              <span className=\"font-serif text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-none\">\n                SK <span className=\"text-stone-600 dark:text-stone-400 font-sans text-lg font-light\">TEXTURE</span>\n              </span>\n              <span className=\"text-[10px] uppercase tracking-[0.25em] text-neutral-500 dark:text-neutral-400 font-medium\">\n                Gurugram \342\200\242 Pan India\n              </span>\n            </div>\n          </a>\n\n          {/* Desktop Nav Links */}\n          <nav className=\"hidden lg:flex items-center gap-7\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                className=\"text-xs uppercase tracking-[0.18em] font-medium text-neutral-700 dark:text-neutral-300 hover:text-stone-900 dark:hover:text-white transition-colors relative group py-1\"\n              >\n                {link.name}\n                <span className=\"absolute bottom-0 left-0 w-0 h-[1.5px] bg-stone-800 dark:bg-stone-200 transition-all duration-300 group-hover:w-full\" />\n              </a>\n            ))}\n          </nav>\n\n          {/* Right Action Controls */}\n          <div className=\"hidden sm:flex items-center gap-4\">\n            {/* Dark Mode Toggle */}\n            <button\n              onClick={() => setDarkMode(!darkMode)}\n              className=\"p-2.5 rounded-full border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors\"\n              title=\"Toggle Theme\"\n              aria-label=\"Toggle Theme\"\n            >\n              {darkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4 text-stone-700\" />}\n            </button>\n\n            {/* Quick Call */}\n            <a\n              href=\"tel:9811221010\"\n              className=\"hidden xl:flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-neutral-800 dark:text-neutral-200 hover:text-stone-600 transition-colors px-3 py-2 rounded-md hover:bg-stone-100 dark:hover:bg-neutral-800/60\"\n            >\n              <Phone className=\"w-3.5 h-3.5 text-stone-600 dark:text-stone-400\" />\n              <span>9811221010</span>\n            </a>\n\n            {/* Book Site Visit CTA */}\n            <button\n              onClick={onOpenSiteVisit}\n              className=\"px-5 py-2.5 text-xs font-semibold tracking-wider uppercase bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white rounded-none shadow-sm hover:shadow-md transition-all flex items-center gap-2 group cursor-pointer\"\n            >\n              <Calendar className=\"w-3.5 h-3.5 text-amber-400 dark:text-amber-600 group-hover:scale-110 transition-transform\" />\n              <span>Book Site Visit</span>\n            </button>\n          </div>\n\n          {/* Mobile Menu Button */}\n          <div className=\"flex items-center gap-2 lg:hidden\">\n            <button\n              onClick={() => setDarkMode(!darkMode)}\n              className=\"p-2 rounded-full border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300\"\n            >\n              {darkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4 text-stone-700\" />}\n            </button>\n\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2.5 text-neutral-900 dark:text-neutral-100 focus:outline-none\"\n              aria-label=\"Toggle Navigation\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden bg-neutral-900/95 backdrop-blur-xl border-b border-neutral-800 px-6 py-6 text-white space-y-4 animate-in slide-in-from-top duration-300\">\n          <nav className=\"flex flex-col space-y-3\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={() => setMobileMenuOpen(false)}\n                className=\"text-sm font-medium tracking-widest uppercase text-neutral-200 hover:text-stone-300 py-1.5 border-b border-neutral-800/50\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </nav>\n\n          <div className=\"pt-3 flex flex-col gap-3\">\n            <a\n              href=\"tel:9811221010\"\n              className=\"w-full py-3 px-4 border border-neutral-700 text-center text-xs tracking-wider uppercase font-semibold text-neutral-200 flex items-center justify-center gap-2\"\n            >\n              <Phone className=\"w-4 h-4 text-stone-400\" /> Call: 9811221010\n            </a>\n\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenSiteVisit();\n              }}\n              className=\"w-full py-3 px-4 bg-stone-100 text-stone-900 text-center text-xs tracking-wider uppercase font-bold flex items-center justify-center gap-2\"\n            >\n              <Calendar className=\"w-4 h-4 text-amber-600\" /> Get Free Site Visit\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
