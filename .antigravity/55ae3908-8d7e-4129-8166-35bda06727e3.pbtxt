  file_change {
    absolute_path_uri: "file:///src/components/Projects.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PROJECTS_LIST } from \'../data/projects\';\nimport { ProjectItem, ProjectCategory } from \'../types\';\nimport { MapPin, Building, ShieldCheck, Calendar, ArrowRight, X, Quote, Star, Layers, Sparkles } from \'lucide-react\';\n\ninterface ProjectsProps {\n  onSelectProject: (project: ProjectItem) => void;\n  onBookSiteVisit: () => void;\n}\n\nexport const Projects: React.FC<ProjectsProps> = ({ onSelectProject, onBookSiteVisit }) => {\n  const [activeCategory, setActiveCategory] = useState<ProjectCategory>(\'All\');\n  const [sliderPositions, setSliderPositions] = useState<{ [key: string]: number }>({});\n  const [selectedProjectModal, setSelectedProjectModal] = useState<ProjectItem | null>(null);\n\n  const categories: ProjectCategory[] = [\n    \'All\',\n    \'Residential\',\n    \'Commercial\',\n    \'Schools\',\n    \'Hospitals\',\n    \'Builders\',\n    \'Apartments\',\n    \'Luxury Villas\'\n  ];\n\n  const filteredProjects = PROJECTS_LIST.filter(p => {\n    if (activeCategory === \'All\') return true;\n    return p.category === activeCategory;\n  });\n\n  const handleSliderChange = (id: string, val: number) => {\n    setSliderPositions(prev => ({ ...prev, [id]: val }));\n  };\n\n  return (\n    <section id=\"projects\" className=\"py-24 bg-white dark:bg-neutral-950 transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Editorial Section Header */}\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 border-b border-stone-200 dark:border-neutral-800 pb-8\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <span className=\"text-xs font-mono uppercase tracking-[0.25em] text-stone-500 dark:text-stone-400\">\n              Landmarks Executed\n            </span>\n            <h2 className=\"font-serif text-3xl sm:text-5xl font-light text-neutral-900 dark:text-neutral-100\">\n              Selected Architectural Case Studies\n            </h2>\n            <p className=\"text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-light\">\n              Explore real before-and-after wall transformations across luxury villas, commercial towers, healthcare facilities, and educational campuses.\n            </p>\n          </div>\n\n          <div className=\"text-xs font-mono text-stone-500 dark:text-stone-400\">\n            Drag before/after slider to view transformation \342\206\224\n          </div>\n        </div>\n\n        {/* Category Filter Pills */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setActiveCategory(cat)}\n              className={`px-4 py-2 text-xs uppercase tracking-widest font-semibold transition-all rounded-xs ${\n                activeCategory === cat\n                  ? \'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900 shadow-md\'\n                  : \'bg-stone-100 dark:bg-neutral-900 text-stone-600 dark:text-stone-400 hover:bg-stone-200 dark:hover:bg-neutral-800\'\n              }`}\n            >\n              {cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Pinterest Masonry Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {filteredProjects.map((project) => {\n            const sliderVal = sliderPositions[project.id] ?? 50;\n\n            return (\n              <div\n                key={project.id}\n                className=\"bg-stone-50/60 dark:bg-neutral-900/60 border border-stone-200 dark:border-neutral-800 rounded-sm overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col justify-between\"\n              >\n                {/* Interactive Before/After Drag Slider Container */}\n                <div className=\"relative aspect-[4/3] w-full overflow-hidden select-none group\">\n                  {/* After Image (Full Background) */}\n                  <img\n                    src={project.afterImage}\n                    alt={`${project.title} After Finish`}\n                    className=\"absolute inset-0 w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n\n                  {/* Before Image (Clipped overlay) */}\n                  <div\n                    className=\"absolute inset-0 overflow-hidden\"\n                    style={{ width: `${sliderVal}%` }}\n                  >\n                    <img\n                      src={project.beforeImage}\n                      alt={`${project.title} Before State`}\n                      className=\"absolute inset-0 w-full h-full object-cover filter grayscale contrast-125 max-w-none\"\n                      style={{ width: \'100%\', height: \'100%\' }}\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n\n                  {/* Before / After Badges */}\n                  <span className=\"absolute top-3 left-3 text-[10px] font-mono tracking-widest px-2 py-0.5 bg-neutral-950/80 text-white rounded-xs z-10 pointer-events-none\">\n                    BEFORE\n                  </span>\n                  <span className=\"absolute top-3 right-3 text-[10px] font-mono tracking-widest px-2 py-0.5 bg-amber-600/90 text-white rounded-xs z-10 pointer-events-none\">\n                    AFTER\n                  </span>\n\n                  {/* Vertical Divider Handle Line */}\n                  <div\n                    className=\"absolute top-0 bottom-0 w-0.5 bg-white shadow-xl z-20 pointer-events-none\"\n                    style={{ left: `${sliderVal}%` }}\n                  >\n                    <div className=\"absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-white text-stone-900 shadow-2xl flex items-center justify-center text-xs font-bold font-mono\">\n                      \342\206\224\n                    </div>\n                  </div>\n\n                  {/* Invisible Native Drag Range Input */}\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"100\"\n                    value={sliderVal}\n                    onChange={(e) => handleSliderChange(project.id, Number(e.target.value))}\n                    className=\"absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30\"\n                    aria-label=\"Before/After Slider\"\n                  />\n                </div>\n\n                {/* Case Study Meta */}\n                <div className=\"p-6 space-y-4\">\n                  <div>\n                    <span className=\"text-[10px] font-mono uppercase tracking-widest text-amber-700 dark:text-amber-400\">\n                      {project.category} \342\200\242 {project.completionDate}\n                    </span>\n                    <h3\n                      onClick={() => setSelectedProjectModal(project)}\n                      className=\"font-serif text-xl font-medium text-neutral-900 dark:text-neutral-100 hover:text-stone-600 dark:hover:text-stone-300 transition-colors cursor-pointer mt-1\"\n                    >\n                      {project.title}\n                    </h3>\n                  </div>\n\n                  <div className=\"space-y-1.5 text-xs text-neutral-600 dark:text-neutral-400 font-light\">\n                    <div className=\"flex items-center gap-2\">\n                      <MapPin className=\"w-3.5 h-3.5 text-stone-500 shrink-0\" />\n                      <span><strong>Location:</strong> {project.location}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Building className=\"w-3.5 h-3.5 text-stone-500 shrink-0\" />\n                      <span><strong>Builder:</strong> {project.builderName}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Layers className=\"w-3.5 h-3.5 text-stone-500 shrink-0\" />\n                      <span><strong>Area Covered:</strong> {project.areaCovered}</span>\n                    </div>\n                  </div>\n\n                  {/* Products Used Tags */}\n                  <div className=\"pt-2 flex flex-wrap gap-1\">\n                    {project.productsUsed.map((prod, idx) => (\n                      <span key={idx} className=\"text-[10px] font-mono px-2 py-0.5 bg-stone-200/60 dark:bg-neutral-800 text-stone-800 dark:text-stone-300 rounded-xs\">\n                        {prod}\n                      </span>\n                    ))}\n                  </div>\n\n                  {/* Verified Review Quote Box */}\n                  <div className=\"p-3 bg-stone-100/80 dark:bg-neutral-800/60 border-l-2 border-amber-600 rounded-r-xs space-y-1\">\n                    <p className=\"text-xs italic text-neutral-700 dark:text-neutral-300\">\n                      \"{project.customerReview.quote}\"\n                    </p>\n                    <p className=\"text-[10px] font-semibold text-neutral-900 dark:text-neutral-100\">\n                      \342\200\224 {project.customerReview.author}, <span className=\"font-normal text-stone-500\">{project.customerReview.role}</span>\n                    </p>\n                  </div>\n                </div>\n\n                {/* Card Action */}\n                <div\n                  onClick={() => setSelectedProjectModal(project)}\n                  className=\"p-4 bg-stone-100/60 dark:bg-neutral-900 border-t border-stone-200/60 dark:border-neutral-800/60 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-stone-800 dark:text-stone-200 hover:text-amber-600 cursor-pointer transition-colors\"\n                >\n                  <span>View Full Gallery & Case Study</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Project Case Study Full Screen Modal */}\n      {selectedProjectModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-neutral-950/85 backdrop-blur-xl animate-in fade-in duration-300 overflow-y-auto\">\n          <div className=\"bg-white dark:bg-neutral-900 border border-stone-200 dark:border-neutral-800 max-w-4xl w-full rounded-sm overflow-hidden shadow-2xl relative my-auto p-6 sm:p-8 space-y-6 max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={() => setSelectedProjectModal(null)}\n              className=\"absolute top-4 right-4 p-2 text-stone-500 hover:text-stone-900 dark:hover:text-white\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div>\n              <span className=\"text-xs font-mono uppercase tracking-widest text-amber-600 font-bold\">\n                {selectedProjectModal.category} Case Study\n              </span>\n              <h3 className=\"font-serif text-3xl font-light text-neutral-900 dark:text-neutral-100 mt-1\">\n                {selectedProjectModal.title}\n              </h3>\n              <p className=\"text-xs font-mono text-stone-500 mt-1\">\n                Completed: {selectedProjectModal.completionDate} \342\200\242 Area: {selectedProjectModal.areaCovered}\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <span className=\"text-[10px] font-mono uppercase tracking-widest text-stone-400 mb-1 block\">Original Wall Condition</span>\n                <img src={selectedProjectModal.beforeImage} alt=\"Before\" className=\"w-full h-56 object-cover rounded-sm filter grayscale\" referrerPolicy=\"no-referrer\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] font-mono uppercase tracking-widest text-amber-600 mb-1 block\">SK Texture Final Finish</span>\n                <img src={selectedProjectModal.afterImage} alt=\"After\" className=\"w-full h-56 object-cover rounded-sm\" referrerPolicy=\"no-referrer\" />\n              </div>\n            </div>\n\n            <p className=\"text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-light\">\n              {selectedProjectModal.description}\n            </p>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 bg-stone-50 dark:bg-neutral-800/60 rounded-sm\">\n              <div>\n                <span className=\"text-[10px] font-mono text-stone-400 uppercase\">Location</span>\n                <p className=\"text-xs font-semibold text-neutral-900 dark:text-neutral-100\">{selectedProjectModal.location}</p>\n              </div>\n              <div>\n                <span className=\"text-[10px] font-mono text-stone-400 uppercase\">Developer</span>\n                <p className=\"text-xs font-semibold text-neutral-900 dark:text-neutral-100\">{selectedProjectModal.builderName}</p>\n              </div>\n              <div>\n                <span className=\"text-[10px] font-mono text-stone-400 uppercase\">Total Surface</span>\n                <p className=\"text-xs font-semibold text-neutral-900 dark:text-neutral-100\">{selectedProjectModal.areaCovered}</p>\n              </div>\n              <div>\n                <span className=\"text-[10px] font-mono text-stone-400 uppercase\">Warranty</span>\n                <p className=\"text-xs font-semibold text-amber-600\">10-Year Guarantee</p>\n              </div>\n            </div>\n\n            <div className=\"pt-2\">\n              <button\n                onClick={() => {\n                  setSelectedProjectModal(null);\n                  onBookSiteVisit();\n                }}\n                className=\"w-full py-3.5 bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 text-xs font-bold uppercase tracking-wider hover:bg-stone-800 transition-colors\"\n              >\n                Schedule Site Visit for Similar Project\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n};\n"
    }
